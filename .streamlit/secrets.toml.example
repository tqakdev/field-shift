EE_SERVICE_ACCOUNT = "your-sa@your-project.iam.gserviceaccount.com"
EE_PROJECT = "your-gcp-project-id"

# Full service-account JSON as a TOML multi-line basic string (inline — not a file path).
# Keep the private_key value as a single JSON string with \\n escapes (as in the .json file).
EE_PRIVATE_KEY_JSON = """
{
  "type": "service_account",
  "project_id": "your-gcp-project-id",
  "private_key_id": "REPLACE_PRIVATE_KEY_ID",
  "private_key": "-----BEGIN PRIVATE KEY-----\\nREPLACE_PRIVATE_KEY_BODY\\n-----END PRIVATE KEY-----\\n",
  "client_email": "your-sa@your-project.iam.gserviceaccount.com",
  "client_id": "REPLACE_CLIENT_ID",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-project.iam.gserviceaccount.com",
  "universe_domain": "googleapis.com"
}
"""

